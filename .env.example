# LLM Provider API Keys（按需填写，不需要的留空）
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
DASHSCOPE_API_KEY=your_dashscope_api_key      # 阿里云百炼 / Qwen
ZHIPUAI_API_KEY=your_zhipuai_api_key          # 智谱 GLM
MOONSHOT_API_KEY=your_moonshot_api_key        # Kimi
MINIMAX_API_KEY=your_minimax_api_key
XAI_API_KEY=your_xai_api_key                  # Grok
MISTRAL_API_KEY=your_mistral_api_key

# 本地模型（Ollama / LM Studio / llama.cpp 等，无需 API Key）
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
LOCAL_LLM_API_KEY=                            # 本地服务若需要鉴权则填写，否则留空

# Adzuna（职位市场数据，用于 Title 发现，免费注册：developer.adzuna.com）
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# Tavily（可选，用于补充职位搜索，免费注册：tavily.com）
TAVILY_API_KEY=your_tavily_api_key

# 默认模型（由 jobradar model 命令自动写入，也可手动设置）
DEFAULT_PROVIDER=gemini
DEFAULT_MODEL=gemini-3.5-flash-lite
ASSESSMENT_WORKERS=5                        # 云端职位深度评估并发数（1-8）；本地模型建议 1

# 缓存配置
CACHE_DB_PATH=data/jobradar_cache.db
JOB_TTL_DAYS=7
SESSION_TTL_HOURS=24

# Gmail 投递追踪（可选，Google Cloud OAuth 2.0 Web client）
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
EMAIL_SYNC_INTERVAL_SECONDS=900
EMAIL_SYNC_MAX_MESSAGES=5000
EMAIL_SYNC_FETCH_WORKERS=8
EMAIL_SYNC_ANALYSIS_WORKERS=3
EMAIL_LLM_CLASSIFICATION_ENABLED=1             # 仅模糊邮件调用默认 LLM；设为 0 则仅使用本地规则


# 日志配置
LOG_LEVEL=INFO                                # DEBUG / INFO / WARNING / ERROR
LOG_FILE=logs/jobradar.log                    # 设为空字符串可禁用文件日志

# SSE 超时配置
SSE_TIMEOUT_MINUTES=30                        # 单轮 SSE 等待上限（分钟），最多自动续期 4 次
